# Trading pair and timeframe
SYMBOL=BTCUSDT
INTERVAL=15m
LOOKBACK=1000

# Capital model
INITIAL_BALANCE=10000
FEE_RATE=0.001
SLIPPAGE=0.0005

# Risk model
RISK_PER_TRADE=0.01
MAX_POSITION_PCT=0.25
STOP_ATR_MULT=1.8
TAKE_PROFIT_RR=2.2
TRAILING_ATR_MULT=1.0
MAX_DAILY_DRAWDOWN=0.05
MAX_CONSECUTIVE_LOSSES=4
MAX_TRADES_PER_DAY=4
WEAK_REGIME_MAX_TRADES_PER_DAY=2
ENTRY_COOLDOWN_CANDLES=2

# Strategy filters
STRATEGY_MODE=auto
MIN_TREND_STRENGTH=0.002
MIN_CONFIDENCE=0.55
MIN_ENTRY_QUALITY=0.72
MIN_VOLUME_Z=-0.15
MAX_ENTRY_RSI=70
MAX_CHASE_ATR_MULT=1.35
USE_REGIME_FILTER=true
USE_MULTI_TIMEFRAME=true
HIGHER_INTERVAL=4h
HIGHER_LOOKBACK=500
MIN_REGIME_TREND_STRENGTH=0.0015
MAX_REGIME_ATR_PCT=0.055
USE_BTC_MACRO_FILTER=true
MACRO_SYMBOL=BTCUSDT
MACRO_INTERVAL=4h
MACRO_LOOKBACK=500
MACRO_EMA_LENGTH=200
MAX_MACRO_DRAWDOWN_PCT=0.12

# Live execution (disabled by default)
LIVE_ENABLED=false
USE_TESTNET=true
ALLOW_REAL_TRADING=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
LIVE_MAX_QUOTE_PER_TRADE=25
LIVE_BLOCK_UNKNOWN_POSITION=true

# Telemetry and alerts
LOG_FILE=bot.log
EVENT_DB_PATH=bot_events.sqlite3
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloud/PostgreSQL (use the Supabase connection pooler URL)
DATABASE_URL=

# Binance Earn automatizado (Fase 11)
# EARN_ENABLED activa el barrido de saldo ocioso a Simple Earn Flexible
# y la redencion automatica cuando el bot necesita liquidez.
EARN_ENABLED=false
EARN_SWEEP_ASSETS=USDT
EARN_RESERVE_USDT=0
EARN_MIN_SUBSCRIBE=0.1
EARN_SWEEP_INTERVAL_MINUTES=60
EARN_DUST_ENABLED=true
# Locked solo se activa si el saldo libre supera EARN_LOCKED_MIN_FREE;
# bloquea EARN_LOCKED_MAX_PCT del excedente hasta EARN_LOCKED_MAX_DURATION_DAYS dias.
EARN_LOCKED_ENABLED=false
EARN_LOCKED_MAX_PCT=0.25
EARN_LOCKED_MIN_FREE=50
EARN_LOCKED_MAX_DURATION_DAYS=30

# Fase 11b: Soft Staking, stack BNB y Dual Investment
# Soft Staking: rendimiento sobre saldo spot elegible, sin bloqueo (activar es seguro)
EARN_SOFT_STAKING_ENABLED=true
# % del USDT ocioso convertido a BNB para elegibilidad Launchpool/HODLer (0 = off)
# ATENCION: implica exposicion al precio de BNB
EARN_BNB_STACK_PCT=0
# Dual Investment BUY-LOW con reglas estrictas (riesgo de settlement al strike)
EARN_DUAL_ENABLED=false
EARN_DUAL_ASSETS=BTC
EARN_DUAL_MIN_DISCOUNT=0.05
EARN_DUAL_MAX_DURATION_DAYS=7
EARN_DUAL_MIN_APR=0.10
EARN_DUAL_MAX_PCT=0.25

# Fase 11c: On-Chain Yields y monitor de anuncios de airdrops
# On-Chain Yields: staking on-chain locked con APR mayor; solo si el saldo
# libre supera EARN_ONCHAIN_MIN_FREE (riesgo de protocolo/iliquidez temporal)
EARN_ONCHAIN_ENABLED=false
EARN_ONCHAIN_MAX_PCT=0.25
EARN_ONCHAIN_MIN_FREE=50
EARN_ONCHAIN_MAX_DURATION_DAYS=30
# Monitor de anuncios Launchpool/HODLer/Megadrop (solo alertas Telegram)
EARN_NEWS_ENABLED=true
EARN_NEWS_INTERVAL_MINUTES=30

# Interactive Brokers (Fase 12)
# Requiere IB Gateway/TWS abierto con API habilitada.
# Puertos: Gateway paper 4002 / live 4001; TWS paper 7497 / live 7496.
IBKR_ENABLED=false
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=17
IBKR_SYMBOLS=SPY
IBKR_INTERVAL=15m
# Para dinero real: puerto live + IBKR_ALLOW_REAL_TRADING=true + --confirm-live
IBKR_ALLOW_REAL_TRADING=false
IBKR_MAX_QUOTE_PER_TRADE=25
IBKR_USE_DELAYED_DATA=true
